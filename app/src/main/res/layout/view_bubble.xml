<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- The disc: accent colour, mic glyph, or an indeterminate spinner while busy. -->
    <FrameLayout
        android:id="@+id/bubble_disc"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/bubble_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="@string/bubble_content_description"
            android:src="@drawable/ic_loqui_mic" />

        <ProgressBar
            android:id="@+id/bubble_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:indeterminateTint="#FFFFFF"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/bubble_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_bubble_label"
        android:maxWidth="220dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
